# Copia este archivo como .env (o usa: python tareas.py crear-env "CADENA_DE_NEON") y completa los valores.
# NUNCA subas el archivo .env a Git.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
CLAVE_ESCRITURA=clave-larga-para-el-formulario
CLAVE_LECTURA=otra-clave-larga-para-el-analista
CLAVE_ADMIN=otra-clave-larga-para-el-administrador
API_URL=http://127.0.0.1:8000
# 1 = al encender el servidor se aplican las migraciones pendientes de la base de datos
MIGRAR_AL_INICIAR=1
# 1 = confiar en el encabezado X-Forwarded-For (poner 1 SOLO detras de un tunel o proxy, como Cloudflare o Render)
CONFIAR_EN_PROXY=0
# 1 = enciende /docs (solo para desarrollar). Normalmente 0: el panel trae su propia documentacion de la API
HABILITAR_DOCS=0
